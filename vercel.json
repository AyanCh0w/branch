{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 180
    },
    "api/share.js": {
      "includeFiles": "app/{index.html,pdfjs/standard_fonts/LiberationSans-Regular.ttf}"
    },
    "api/share-image.js": {
      "includeFiles": "app/pdfjs/standard_fonts/LiberationSans-Regular.ttf"
    }
  },
  "rewrites": [
    {
      "source": "/app",
      "has": [
        {
          "type": "query",
          "key": "join"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/app",
      "has": [
        {
          "type": "query",
          "key": "board"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/app/",
      "has": [
        {
          "type": "query",
          "key": "join"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/app/",
      "has": [
        {
          "type": "query",
          "key": "board"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/app",
      "destination": "/workspace.html"
    },
    {
      "source": "/app/",
      "destination": "/workspace.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "board"
        }
      ],
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "join"
        }
      ],
      "destination": "/app",
      "permanent": false
    }
  ]
}
