{
  "manifest_version": 3,
  "name": "Branch ChatGPT Sync",
  "version": "0.3.0",
  "description": "Save completed replies from selected ChatGPT conversations to your Branch boards.",
  "key": "",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://joinbranch.dev/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["capture.js", "content.js"],
    "run_at": "document_idle"
  }]
}
