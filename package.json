    "@resvg/resvg-wasm": "^2.6.2",
    "dompurify": "^3.4.17",
    "jose": "^6.2.17",
    "katex": "^0.19.1",
    "marked": "^18.2.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yjs": "^13.6.33",
    "youtube-transcript-plus": "^2.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@convex-dev/auth": "^2.0.0",
    "@types/node": "^26.6.6",
    "convex": "^1.49.0",
    "convex-test": "^0.0.71",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.1"
  },
