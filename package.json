  "main": "index.js",
  "scripts": {
    "build": "esbuild --tsconfig=tsconfig.json accounts/app.jsx --bundle --format=iife --define:process.env.NODE_ENV='\"production\"' --outfile=app/accounts.bundle.js && esbuild --tsconfig=tsconfig.json app/markdown-entry.js --bundle --format=iife --outfile=app/markdown.bundle.js && node app/build-math.cjs && node app/build-pdf.cjs && esbuild --tsconfig=tsconfig.json app/landing-shader.mjs --bundle --format=iife --minify --outfile=app/landing-shader.bundle.js",
    "dev": "node app/server.cjs",
    "convex:dev": "convex dev",
    "test": "node --test app/tests/*.test.cjs && vitest run",
    "typecheck": "tsc --noEmit -p convex",
    "build:vercel": "npm run build && node scripts/build-public.cjs",
    "mcp": "node mcp/server.cjs",
    "convex:deploy": "convex deploy",
    "build:cloudflare": "npm run build && node scripts/build-public.cjs && node scripts/build-cloudflare.cjs",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
