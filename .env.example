# Copy to .env.local and supply your own values. Never commit credentials.
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only; never use VITE_/NEXT_PUBLIC_ prefixes for these two values.
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Hosted ChatGPT plan usage requires explicit OpenAI approval (not identity-only).
# Configure CHATGPT_* on both the API server and background worker. Never use Codex's client ID or credentials.
CHATGPT_HOSTED_APPROVED=false
CHATGPT_CLIENT_ID=
CHATGPT_REDIRECT_URI=
CHATGPT_TOKEN_AUTH_METHOD=none
CHATGPT_CLIENT_SECRET=
# Stable random 32-byte hexadecimal key. Keep private; never rotate casually.
CHATGPT_ENCRYPTION_KEY=
