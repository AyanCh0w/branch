# Copy to .env.local and supply your own values. Never commit credentials.
OPENAI_API_KEY=
CONVEX_URL=
# HTTP actions URL (https://<deployment>.convex.site). The app server forwards
# /api/backend?coding|chrome|desktop here.
CONVEX_SITE_URL=
# Long random value. Set the same value in the Convex deployment's environment
# (npx convex env set BRANCH_PROXY_SECRET ...). Requests without it are rejected.
BRANCH_PROXY_SECRET=

# Hosted ChatGPT plan usage requires explicit OpenAI approval (not identity-only).
# Configure all CHATGPT_* values in Convex; also set CHATGPT_ENCRYPTION_KEY
# on the app server. Never use Codex's client ID or credentials.
CHATGPT_HOSTED_APPROVED=false
CHATGPT_CLIENT_ID=
CHATGPT_REDIRECT_URI=
CHATGPT_TOKEN_AUTH_METHOD=none
CHATGPT_CLIENT_SECRET=
# Stable random 32-byte hexadecimal key. Keep private; never rotate casually.
CHATGPT_ENCRYPTION_KEY=

# GitHub App for repositories as board context. Setup: docs/github.md.
GITHUB_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_SECRET=
# One line; write the PEM line breaks as \n.
GITHUB_PRIVATE_KEY=
