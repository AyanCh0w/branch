{
  "name": "branch",
  "account_id": "7463e61beec84f503e6edab2ed2bdc5d",
  "main": ".worker-build/index.mjs",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "placement": { "region": "aws:us-east-1" },
  "routes": [
    { "pattern": "joinbranch.dev", "custom_domain": true },
    { "pattern": "www.joinbranch.dev", "custom_domain": true }
  ],
  "no_bundle": true,
  "find_additional_modules": true,
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/app",
      "/app/",
      "/"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "CLOUDFLARE_WORKER": "true"
  },
  "preview_urls": false
}
